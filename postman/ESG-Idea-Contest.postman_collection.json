  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Attach X-CSRF-Token to every write (PRD 6.5). Token is session-bound and changes at login/logout.",
          "const m = pm.request.method;",
          "if (['POST', 'PUT', 'DELETE', 'PATCH'].includes(m)) {",
          "  const set = (t) => pm.request.headers.upsert({ key: 'X-CSRF-Token', value: t });",
          "  const cached = pm.collectionVariables.get('csrfToken');",
          "  if (cached) { set(cached); }",
          "  else {",
          "    pm.sendRequest({ url: pm.variables.replaceIn('{{baseUrl}}/auth/csrf'), method: 'GET' }, (err, res) => {",
          "      if (err) { console.error('csrf fetch failed', err); return; }",
          "      const t = res.json().token;",
          "      pm.collectionVariables.set('csrfToken', t);",
          "      set(t);",
          "    });",
          "  }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A 403 CSRF_INVALID means the cached token is stale: drop it so the next send refetches.",
          "if (pm.response.code === 403) {",
          "  try { if (pm.response.json().code === 'CSRF_INVALID') pm.collectionVariables.unset('csrfToken'); } catch (e) {}",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "csrfToken",
      "value": ""
    },
    {
