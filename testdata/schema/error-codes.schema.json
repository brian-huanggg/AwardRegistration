{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error-codes.schema.json",
  "title": "Error code catalogue",
  "description": "Shared front-end/back-end list of {code, status}; human-readable table lives in docs/API/error-codes.md.",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code", "status"],
    "properties": {
      "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$" },
      "status": { "type": "integer", "minimum": 400, "maximum": 599 }
    }
  }
}
