{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "password.schema.json",
  "title": "Password policy cases",
  "description": "Shared front-end/back-end cases for PRD 6.4: every violated rule id, in table order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "password",
          "empNo",
          "wantRules"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string"
          },
          "empNo": {
            "type": "string",
            "pattern": "^([0-9]{6})?$"
          },
          "wantRules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "LENGTH",
                "CHARSET",
                "COMPLEXITY",
                "COMMON_PASSWORD",
                "KEYBOARD_RUN",
                "SEQUENCE",
                "REPEAT",
                "CONTAINS_EMP_NO"
              ]
            }
          }
        }
      }
    }
  }
}
